# ========================================
# NutriCloudMonitor Backend Configuration
# ========================================

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthcart?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here_change_in_production
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here_change_in_production

# Server Port & Environment
PORT=5000
NODE_ENV=production

# Frontend Application Origin (CORS & Socket.io)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
